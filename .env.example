VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Cloudinary (Upload gratuito de imagens)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Web Push Notifications (FCM VAPID Key)
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here

# Groq API
VITE_GROQ_API_KEY=your_groq_api_key_here
# Modelo principal para análise de documentos e LangChain (ex: qwen/qwen3.6-27b ou groq/compound)
VITE_GROQ_MODEL=qwen/qwen3.6-27b
# Modelo leve para respostas rápidas e baixo consumo de tokens (ex: groq/compound-mini)
VITE_GROQ_MODEL_LIGHT=groq/compound-mini
